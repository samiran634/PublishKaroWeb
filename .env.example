# Supabase Configuration (Required)
# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: App identifier
VITE_APP_ID=publishkaro

# Optional: local AI prototype only
# Warning: any VITE_* variable is embedded into the client bundle at build time.
# Move Gemini access behind a server route before exposing it publicly.
VITE_GEMINI_API_KEY=
